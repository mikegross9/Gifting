// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts  Contact[]
  gifts     Gift[]
  settings  UserSettings?
}

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvalWindowDays    Int     @default(7) // Days before event to request approval
  autoSendEnabled       Boolean @default(true) // Auto-send if not approved
  notificationsEnabled  Boolean @default(true)
  defaultBudgetMin      Float   @default(25.0)
  defaultBudgetMax      Float   @default(100.0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum RelationshipType {
  FAMILY
  FRIEND
  COLLEAGUE
  OTHER
}

model Contact {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  relationship RelationshipType
  birthday     DateTime?
  email        String?
  phone        String?
  address      String?

  preferences  String? // JSON string of gift preferences
  notes        String?
  budgetMin    Float?
  budgetMax    Float?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  gifts        Gift[]
  events       Event[]

  @@index([userId])
}

enum EventType {
  BIRTHDAY
  MOTHERS_DAY
  FATHERS_DAY
  VALENTINES_DAY
  CHRISTMAS
  ANNIVERSARY
  CUSTOM
}

model Event {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type        EventType
  name        String
  date        DateTime
  recurring   Boolean   @default(false) // Annual recurrence

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gifts       Gift[]

  @@index([contactId])
  @@index([date])
}

enum GiftStatus {
  PENDING_RECOMMENDATION
  PENDING_APPROVAL
  APPROVED
  MODIFIED
  REJECTED
  ORDERED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Gift {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)

  status          GiftStatus  @default(PENDING_RECOMMENDATION)

  name            String
  description     String?
  price           Float
  url             String?
  imageUrl        String?

  cardMessage     String?     // AI-generated card message

  recommendedAt   DateTime    @default(now())
  approvalDeadline DateTime?  // Deadline for user to approve
  approvedAt      DateTime?
  orderedAt       DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([contactId])
  @@index([status])
  @@index([approvalDeadline])
}
